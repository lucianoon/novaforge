# Nova Forge environment configuration
# Copy this file to .env and replace the placeholder values.

# Senha do painel administrativo. É comparada no servidor, em tempo constante —
# o cliente nunca recebe este valor. Use algo longo e aleatório.
ADMIN_KEY=replace-with-a-long-random-admin-token

# Chave que assina o cookie de sessão. Obrigatória em produção: sem ela a chave
# é aleatória por processo, e todo restart desloga o admin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-random-bytes-hex

# Optional database configuration, depending on your deployment/storage setup.
DATABASE_URL=postgresql://user:password@localhost:5432/novaforge

# Optional email/API integrations.
SENDGRID_API_KEY=
